{
  "name": "ez-php/mail-events",
  "version": "2.6.3",
  "description": "Normalises Mailgun and SendGrid delivery webhooks (delivered, bounced, complained, opened, clicked) into provider-neutral events dispatched through ez-php/events",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["mail", "webhooks", "mailgun", "sendgrid", "bounces", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/mail-events",
  "support": {
    "issues": "https://github.com/ez-php/mail-events/issues",
    "source": "https://github.com/ez-php/mail-events"
  },
  "require": {
    "php": "^8.5",
    "ez-php/contracts": "^2.6.0",
    "ez-php/http": "^2.6.0",
    "ez-php/events": "^2.6.0"
  },
  "suggest": {
    "ext-openssl": "Needed for SendGrid\\SendGridSignature (ECDSA signed event webhook)"
  },
  "require-dev": {
    "ez-php/docker": "^2.6.3",
    "ez-php/testing-application": "^2.6.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\MailEvents\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
